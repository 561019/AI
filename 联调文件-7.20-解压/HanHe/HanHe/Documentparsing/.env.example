# PostgreSQL task queue, result JSON, review decisions, and package registry.
DATABASE_URL=postgresql://docengine:docengine@postgres:5432/docengine

# S3-compatible object storage. These values match the integration Compose file.
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_ACCESS_KEY=docengine
OBJECT_STORE_SECRET_KEY=change-this-secret
OBJECT_STORE_BUCKET=document-engine
OBJECT_STORE_REGION=us-east-1

# SiliconFlow-hosted PaddleOCR-VL-1.5. Copy this file to .env and set the key;
# never commit the populated .env file. PDF rendering is local, OCR is remote.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
OCR_TIMEOUT_SECONDS=180
OCR_MAX_RETRIES=3
OCR_MAX_TOKENS=8192
# SiliconFlow does not return calibrated confidence. The conservative default
# stays below the normal 0.85 review threshold so remote OCR is human-reviewed.
OCR_DEFAULT_CONFIDENCE=0.80
PDF_RENDER_DPI=144
PDF_MAX_PAGES=100
OCR_MAX_IMAGE_PIXELS=4000000

# Permission-center placeholder. The integration environment uses demo permissions.
PERMISSION_API_URL=
PERMISSION_API_KEY=
ALLOW_DEMO_ACTOR=true

ENABLE_EMBEDDED_WORKER=false
WORKER_POLL_SECONDS=1.0
LOCAL_DATA_DIR=/data
MAX_UPLOAD_BYTES=104857600
