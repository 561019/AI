# SiliconFlow text embedding API. Never commit a real key.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=3
QUERY_INSTRUCTION=Given a user query, retrieve relevant document passages that answer it

# Milvus standalone, cluster, or Zilliz Cloud connection.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=document_chunks
MILVUS_BATCH_SIZE=100

# Local auditable process files.
PROCESS_OUTPUT_DIR=process-output
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=800
CHUNK_MIN_TOKENS=120
CHUNK_OVERLAP_TOKENS=80
EMBED_REVIEW_REQUIRED=false

