# The same SiliconFlow account can be used by Documentparsing and
# ChunkingVectorization. Never commit the populated .env file.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=3
QUERY_INSTRUCTION=Given a user query, retrieve relevant document passages that answer it

RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_INSTRUCTION=根据用户查询，按照文档片段对回答查询的相关性进行排序
RERANK_TIMEOUT_SECONDS=120
RERANK_MAX_RETRIES=3

# Must match the collection written by ChunkingVectorization.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=hanhe_document_chunks

DEFAULT_CANDIDATE_K=30
DEFAULT_TOP_N=5
MAX_CANDIDATE_K=200

# Permission-center adapter. Local testing permits only demo-user.
PERMISSION_API_URL=
PERMISSION_API_KEY=
ALLOW_DEMO_ACTOR=true

