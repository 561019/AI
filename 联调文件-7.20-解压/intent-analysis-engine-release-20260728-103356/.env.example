APP_ENV=local
BACKEND_PORT=8000
FRONTEND_PORT=5173
MODEL_SERVICE_PORT=8001

POSTGRES_DB=intent_analysis
POSTGRES_USER=intent
POSTGRES_PASSWORD=intent
DATABASE_URL=postgresql+psycopg://intent:intent@postgres:5432/intent_analysis

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=intent_vectors

MODEL_API_URL=http://local-model-service:8001/v1
MODEL_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL_NAME=BAAI/bge-base-zh-v1.5
EMBEDDING_LOCAL_FILES_ONLY=false
BGE_EMBEDDING_DIMENSION=768
VECTOR_BACKEND=milvus
EMBEDDING_RUNTIME=in_process
BGE_KEEP_WARM=true
RERANK_MODEL=bge-reranker-v2-m3

# LLM provider for Level3 complex task understanding.
# Daily development defaults to mock to avoid accidental external calls.
# DeepSeek example:
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=your-api-key
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-llm
LLM_TIMEOUT_SECONDS=120

RULE_THRESHOLD=0.9
ENABLE_SEMANTIC_MATCHING=true
SEMANTIC_THRESHOLD=0.50
LLM_CONFIDENCE_THRESHOLD=0.70
IMPLICIT_TASK_CONFIDENCE_THRESHOLD=0.70
IMPLICIT_FALLBACK_BATCH_CHARACTERS=8000
CONVERSATION_HISTORY_LIMIT=20
LONG_TEXT_CHUNK_SIZE=2000
LONG_TEXT_CHUNK_OVERLAP=200
LONG_TEXT_ACTIVATION_LENGTH=120
LONG_TEXT_ACTIVATION_SENTENCES=3

VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://backend:8000
