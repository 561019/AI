L1_INTERFACE_HOST=127.0.0.1
L1_INTERFACE_PORT=8002
L1_INTERFACE_SERVICE_SECRET=replace-with-a-long-random-secret
L1_INTERFACE_PERMISSION_URL=http://127.0.0.1:8001
L1_INTERFACE_PERMISSION_MECHANISM_SECRET=replace-with-the-same-permission-secret
L1_INTERFACE_TARGET_SERVICE_SECRET=replace-with-a-long-random-secret
# Dev-only shared verifier. Set it to the account gateway JWT signing secret.
# Production uses the account gateway IdentityContext signing public key.
L1_INTERFACE_IDENTITY_CONTEXT_SECRET=replace-with-account-gateway-context-signing-secret
L1_INTERFACE_ACCOUNT_GATEWAY_URL=http://127.0.0.1:8080
L1_INTERFACE_TIMEOUT_MS=2000
