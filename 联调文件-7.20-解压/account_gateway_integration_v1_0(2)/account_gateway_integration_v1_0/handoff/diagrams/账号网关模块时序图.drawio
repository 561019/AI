        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="l1">
          <mxGeometry x="45" y="140" width="10" height="350" as="geometry"/>
