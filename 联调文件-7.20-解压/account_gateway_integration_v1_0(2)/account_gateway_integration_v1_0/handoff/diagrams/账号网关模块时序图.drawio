        <mxCell id="m14" value="返回身份上下文" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8642;" edge="1" parent="1" source="act6" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note15" value="账号网关只回答“是谁、挂什么岗”；不产生业务权限 allow/deny" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
