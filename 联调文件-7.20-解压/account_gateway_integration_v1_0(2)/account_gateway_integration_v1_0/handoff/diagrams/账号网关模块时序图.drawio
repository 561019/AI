        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="idp">
          <mxGeometry x="45" y="340" width="10" height="50" as="geometry"/>
