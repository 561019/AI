<mxfile host="drawio" version="26.0.0">
  <diagram name="权限管理模块流程">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="权限管理模块实时判权流程" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="600" height="40" as="geometry" /></mxCell>
        <mxCell id="3" value="唯一权威：每次操作实时查询，不设权限缓存、不做判定副本；无依据默认禁止" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="390" y="60" width="820" height="30" as="geometry" /></mxCell>
        <mxCell id="4" value="L1 对内通道&#xa;机制性直达请求" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="5" value="校验机制直达身份&#xa;ingress_mode / caller secret&#xa;禁止业务模块直连" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="6" value="入口可信？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="150" height="90" as="geometry" /></mxCell>
        <mxCell id="7" value="拒绝直连&#xa;UNTRUSTED_INGRESS" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="125" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="8" value="校验请求契约&#xa;actor + action + data + context&#xa;账号真人必须同一 ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="280" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="9" value="字段合法？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="285" width="150" height="90" as="geometry" /></mxCell>
        <mxCell id="10" value="error&#xa;400 / 422&#xa;decision_id = null" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="285" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="11" value="实时规则计算（固定顺序）" style="swimlane;startSize=36;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="180" y="440" width="1100" height="390" as="geometry" /></mxCell>
        <mxCell id="12" value="1. 服务调用关系&#xa;source → target → action" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="11"><mxGeometry x="30" y="60" width="180" height="75" as="geometry" /></mxCell>
        <mxCell id="13" value="2. 动作目录与数据约束&#xa;标签 / 状态 / resource_id" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="11"><mxGeometry x="250" y="60" width="190" height="75" as="geometry" /></mxCell>
        <mxCell id="14" value="3. 当前真人身份事实&#xa;有效岗位 / 管理范围 / 租户" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="11"><mxGeometry x="480" y="60" width="190" height="75" as="geometry" /></mxCell>
        <mxCell id="15" value="4. 制度强制拒绝&#xa;deny 优先于所有 allow" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="11"><mxGeometry x="710" y="60" width="180" height="75" as="geometry" /></mxCell>
        <mxCell id="16" value="强制拒绝命中？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="11"><mxGeometry x="930" y="55" width="140" height="85" as="geometry" /></mxCell>
        <mxCell id="17" value="5. 岗位标准配置" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="11"><mxGeometry x="140" y="210" width="180" height="65" as="geometry" /></mxCell>
        <mxCell id="18" value="6. 管理树范围" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;" vertex="1" parent="11"><mxGeometry x="360" y="210" width="180" height="65" as="geometry" /></mxCell>
