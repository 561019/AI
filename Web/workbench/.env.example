# 前端本地开发时，Vite 会把 /api 请求代理到这里。
# 如果前端和后端在同一台电脑，保持默认即可：
# VITE_PLATFORM_PROXY_TARGET=http://127.0.0.1:8100

# 如果前端同事在另一台电脑运行前端，请改成后端所在电脑的局域网地址：
# VITE_PLATFORM_PROXY_TARGET=http://192.168.1.100:8100

VITE_PLATFORM_TENANT_ID=web-workbench

# 前端只改页面时设为 true，可免登录直接进入主页面。
# 做真实前后端联调时设为 false。
VITE_WORKBENCH_SKIP_AUTH=false
