# Copy this file to model.env. Do not commit real API keys.
# The application defaults to Doubao. MODEL_PROVIDER is read only from model.env.
MODEL_PROVIDER=doubao

# Doubao / Volcengine Ark
# Use a model ID or an inference endpoint ID enabled in your Ark account.
DOUBAO_API_KEY=replace_with_your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1.8
DOUBAO_TIMEOUT_SECONDS=30

# Optional future switch; not used while MODEL_PROVIDER=doubao.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
